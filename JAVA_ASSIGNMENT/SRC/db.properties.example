# Default: SQLITE (Self-contained, zero-configuration file 'kec_academic.db')
db.type=SQLITE

# For MySQL Database Deployment:
# 1. Change db.type to MYSQL
# 2. Run the DDL script 'kec_schema.sql' in your MySQL instance
# 3. Configure credentials below:
# db.type=MYSQL
# db.url=jdbc:mysql://localhost:3306/kec_academic?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
# db.user=root
# db.password=your_password
